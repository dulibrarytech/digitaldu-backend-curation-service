# Place at /etc/nginx/conf.d/curation-api.conf

server {
    listen 443 ssl http2;
    server_name curation-api.internal;

    ssl_certificate     /etc/pki/tls/certs/curation-api.crt;
    ssl_certificate_key /etc/pki/tls/private/curation-api.key;

    # make_digital_objects can run up to ~1 hour; match gunicorn timeout
    proxy_read_timeout 3700s;
    proxy_send_timeout 3700s;
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:8185;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
