[Unit]
Description=DigitalDU Curation API
After=network.target

[Service]
Type=simple
User=curation
Group=curation
WorkingDirectory=/library/lib-sftp/digitaldu-backend-curation-service
EnvironmentFile=/etc/curation-api/env
ExecStart=/library/lib-sftp/digitaldu-backend-curation-service/.venv/bin/gunicorn \
  --bind 127.0.0.1:8185 \
  --workers 4 \
  --timeout 3700 \
  --graceful-timeout 30 \
  --max-requests 1000 \
  --max-requests-jitter 50 \
  --access-logfile /var/log/curation-api/access.log \
  --error-logfile /var/log/curation-api/error.log \
  --capture-output \
  app:app
Restart=on-failure
RestartSec=5

# Security hardening
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/curation-api /data
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
