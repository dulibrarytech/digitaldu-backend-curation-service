# Copy to .env (or load via systemd EnvironmentFile=/etc/curation-api/env)
# and fill in real values. Permission: 0600, owned by the service user.

# --- Auth ---
API_KEY=

# --- Server ---
APP_PORT=8185
APP_VERSION=curation-api 1.0.0

# --- Archivematica side (was qa-service) ---
READY_PATH=/data/ready
INGEST_PATH=/data/ingest
INGESTED_PATH=/data/ingested
SFTP_HOST=archivematica.internal
SFTP_ID=
SFTP_PWD=
SFTP_REMOTE_PATH=/path/on/remote
# Polite-citizen SFTP throttles (per gunicorn worker): hard cap on
# concurrent SSH sessions to the AM SFTP host, and minimum spacing
# between successive logins — a burst of connections trips sshd
# MaxStartups and reads like an attack to the vendor.
SFTP_MAX_SESSIONS=5
SFTP_CONNECT_MIN_INTERVAL_S=1.0
# Directory for the host-global flock slot files (shared by all
# gunicorn workers; must be writable by the curation user and inside
# the systemd unit's writable paths — PrivateTmp makes /tmp fine).
SFTP_LOCK_DIR=/tmp/curation-sftp-slots
WASABI_ENDPOINT=
WASABI_BUCKET=
WASABI_PROFILE=

# --- AIP store (Stage 6 / /api/v2/aip/*) ------------------------------------
# AIP-store bucket (separate from the SFTP-staging WASABI_BUCKET above),
# e.g. s3://library-repository/aip-store/. REQUIRED for copy-to-wasabi;
# unset = the route refuses loudly rather than writing to the wrong bucket.
WASABI_AIP_BUCKET=
# AM Storage Service — same three values as repo-backend-v2's
# ARCHIVEMATICA_STORAGE_* env; all three required for the AIP endpoints.
ARCHIVEMATICA_STORAGE_API=
ARCHIVEMATICA_STORAGE_USERNAME=
ARCHIVEMATICA_STORAGE_API_KEY=
# Read timeout (seconds) for the AM /download/ stream: bounds time-to-
# first-byte and mid-stream silence. Keep GENEROUS — AM preps large
# packages for a long time before the first byte (hours at tens of GB).
# Default 6h; 0 = open-ended (pre-2026-07-31 behavior).
#AM_DOWNLOAD_READ_TIMEOUT_SECONDS=21600
# DuraCloud — failover source for the AIP copy when AM's download path
# can't serve large AIPs (/api/v2/aip/copy-from-duracloud). Same three
# values as repo-backend-v2's DURACLOUD_* env. Optional: unset = only
# the DuraCloud route refuses; the AM path is unaffected.
DURACLOUD_API=
DURACLOUD_USER=
DURACLOUD_PWD=
# AIPs >= this size copy FROM DURACLOUD BY DEFAULT (Artefactual rec,
# 2026-08-03 — SS /download/ hung/502'd at 66-75 GB). Default 1 GB
# (= DuraCloud's chunking threshold). 0 disables routing.
#AIP_DURACLOUD_THRESHOLD_BYTES=1000000000
# Numeric gid of the shared staff group restored on 001-ready batch
# folders after archiving (`getent group "domain users"` → third field).
# The owner is never changed (UID is retired).
GID=345200513
ERRORS_FILE=/var/log/curation-api/errors.log
BATCH_SIZE_LIMIT=

# AWS credentials
AWS_DEFAULT_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- TIFF->JPG derivatives (routes/convert.py) ------------------------------
# Takes over derivative generation from the libspec02 convert service —
# see repo/DERIVATIVE_PIPELINE_PLAN.md. Reuses the DURACLOUD_* values
# above for the dip-store fetch. Optional: when DERIVATIVE_STORAGE_PATH
# is unset, only the convert routes refuse; the rest of the app is
# unaffected.
#
# Where derivative JPGs are written and served from — a directory on the
# 9TB share, writable by the service user. ABSOLUTE path.
DERIVATIVE_STORAGE_PATH=
# Refuse conversions (HTTP 507) when the storage volume has less free
# space than this, in bytes. A full volume writes 0-byte files while
# reporting success (the 2026-08-04 libspec02 incident). Default 10GB.
#DERIVATIVE_MIN_FREE_BYTES=10737418240
# JPEG quality for generated derivatives — they are the IIIF deep-zoom
# source, so favor quality over size. Default 85 (libspec02 used 75).
#DERIVATIVE_JPEG_QUALITY=85
# Refuse source TIFFs larger than this, in bytes. DuraCloud chunks
# objects >1GB into .dura-chunk-* parts that cannot be fetched raw
# anyway. Default 2GB.
#DERIVATIVE_MAX_SOURCE_BYTES=2147483648

# --- ArchivesSpace side (was astools-web_v2) ---
WORKSPACE=/data/workspace
ASPACE_USERNAME=
ASPACE_PASSWORD=
SCRIPT_PATH=/opt/curation-api/lib
SCRIPT_NAME_PY=make_digital_object.py
LOG_PATH=/var/log/curation-api/aspace
# ArchivesSpace API base URL. REQUIRED — lib/make_digital_object.py reads it
# from the environment and exits before doing any work if it is unset, so
# /api/v1/astools/make-digital-objects fails on the first call without it.
DEFAULT_URL=
# Used instead of DEFAULT_URL when the request sets test=true. Defaults to
# DEFAULT_URL when unset, i.e. test runs hit the production instance.
#TESTING_URL=
# ArchivesSpace repository id. Defaults to 2.
#ASPACE_REPOSITORY_ID=2
